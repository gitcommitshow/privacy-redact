{
  "name": "privacy-redact",
  "version": "1.0.2",
  "type": "module",
  "description": "Library for detecting private content, redacting it, and handling document metadata. Browser components cover OCR, faces, barcodes, and PDF pages.",
  "exports": {
    ".": "./src/index.js",
    "./ui": "./src/review/element.js",
    "./react": "./src/review/react.js",
    "./vite": "./src/host/assets.js",
    "./detect/ocr": "./src/detect/ocr.js",
    "./detect/faces": "./src/detect/faces.js",
    "./detect/barcodes": "./src/detect/barcodes.js",
    "./render/effects": "./src/render/effects.js",
    "./io/loader": "./src/io/loader.js",
    "./io/exporter": "./src/io/exporter.js",
    "./io/metadata": "./src/io/metadata.js"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gitcommitshow/privacy-redact.git"
  },
  "homepage": "https://github.com/gitcommitshow/privacy-redact#readme",
  "bugs": {
    "url": "https://github.com/gitcommitshow/privacy-redact/issues"
  },
  "files": [
    "src",
    "scripts/copy-assets.mjs",
    "README.md"
  ],
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "scripts": {
    "postinstall": "node scripts/copy-assets.mjs",
    "dev": "vite",
    "playground": "npm run dev --prefix examples/playground",
    "build": "node scripts/copy-assets.mjs && vite build",
    "preview": "vite preview",
    "test": "node --test \"test/!(*.e2e).test.js\"",
    "test:e2e": "node test/smoke.e2e.test.js",
    "test:e2e:setup": "playwright install chromium",
    "test:e2e:ci": "node scripts/run-e2e.mjs",
    "samples": "node scripts/make-samples.mjs",
    "desktop": "npm run build && npx electron desktop/main.cjs",
    "desktop:pack": "npm run build && npx electron-builder --config desktop/electron-builder.yml",
    "examples": "node scripts/make-examples.mjs",
    "examples:inputs": "node scripts/make-example-inputs.mjs"
  },
  "devDependencies": {
    "jsbarcode": "^3.12.3",
    "playwright": "^1.63.0",
    "qrcode": "^1.5.4",
    "vite": "^8.3.2",
    "wait-on": "^9.4.0"
  },
  "dependencies": {
    "@tesseract.js-data/eng": "^1.0.0",
    "@vladmandic/face-api": "^1.7.15",
    "@zxing/library": "^0.23.0",
    "exifr": "^7.1.3",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.3.289",
    "tesseract.js": "^7.0.0"
  },
  "keywords": [
    "privacy",
    "redaction",
    "redact",
    "screenshot",
    "pdf",
    "ocr",
    "pii",
    "exif",
    "gps",
    "metadata",
    "blur",
    "face-blur",
    "anonymize",
    "local-first",
    "offline"
  ],
  "engines": {
    "node": ">=24"
  }
}
